{
  "name": "workbench-web",
  "projectType": "application",
  "sourceRoot": "apps/workbench-web/src",
  "tags": ["platform:browser", "scope:workbench"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite --config apps/workbench-web/vite.config.ts --host 127.0.0.1 --port 4200"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite build --config apps/workbench-web/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p apps/workbench-web/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint --config apps/workbench-web/eslint.config.mjs apps/workbench-web/src"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec prettier --check apps/workbench-web" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test apps/workbench-web/src/entities/session/model/*.test.ts apps/workbench-web/src/shared/api/*.test.ts apps/workbench-web/src/widgets/session-workspace/ui/*.test.tsx apps/workbench-web/scripts/*.test.mjs"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test --config apps/workbench-web/playwright.config.ts"
      }
    },
    "boundaries": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/workbench-web/scripts/check-boundaries.mjs"
      }
    }
  }
}
