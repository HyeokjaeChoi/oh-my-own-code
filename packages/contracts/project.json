{
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "packages/contracts/src",
  "tags": ["platform:isomorphic", "scope:contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p packages/contracts/tsconfig.build.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p packages/contracts/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint --config scripts/eslint.config.mjs packages/contracts/src"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check packages/contracts/src packages/contracts/package.json packages/contracts/project.json packages/contracts/tsconfig.json packages/contracts/tsconfig.build.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import tsx --test packages/contracts/src/*.test.ts"
      }
    }
  }
}
