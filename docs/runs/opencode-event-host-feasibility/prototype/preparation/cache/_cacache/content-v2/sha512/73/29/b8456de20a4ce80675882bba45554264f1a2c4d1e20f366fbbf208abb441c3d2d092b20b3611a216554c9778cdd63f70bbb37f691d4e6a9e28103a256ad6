r","cloudflare-workers","hyperdrive","deno","bun","edge"],"repository":{"url":"git+https://github.com/drizzle-team/minipg.git","type":"git"},"_npmVersion":"11.19.0","description":"A minimal, dependency-free PostgreSQL driver for Node, Bun, Deno, and Cloudflare Workers.","directories":{},"maintainers":[{"name":"dankochetov","email":"danil.kochetov+npm@gmail.com"},{"name":"sheriman","email":"andreysherman11@gmail.com"},{"name":"alexblokh","email":"aleksandrblokh@gmail.com"},{"name":"kyrylo_usichenko","email":"kyrylo.usichenko@gmail.com"}],"_nodeVersion":"24.21.0","publishConfig":{"access":"public","provenance":true},"_hasShrinkwrap":false,"devDependencies":{"pg":"^8.22.0","mitata":"^1.0.34","tsdown":"^0.22.3","vitest":"~2.1.9","publint":"^0.3.23","postgres":"^3.4.9","prettier":"^3.9.1","wrangler":"^3.90.0","@types/pg":"^8.20.0","@types/bun":"latest","fast-check":"^4.8.0","pkg-pr-new":"0.0.88","typescript":"^5","drizzle-kit":"^0.31.10","drizzle-orm":"^0.45.2","cli-highlight":"^2.1.11","@mitata/counters":"^0.0.8","@arethetypeswrong/cli":"^0.18.5","@cloudflare/vitest-pool-workers":"^0.5.2"},"_npmOperationalInternal":{"host":"s3://npm-registry-packages-npm-production","tmp":"tmp/minipg_0.4.1_1790854248217_0.8559105066441517"}}},"time":{"created":"2026-08-11T20:55:45.872Z","modified":"2026-10-01T11:30:48.753Z","0.3.1":"2026-08-11T20:55:46.187Z","0.3.2":"2026-08-11T21:15:16.721Z","0.3.3":"2026-08-12T12:30:06.380Z","0.3.4":"2026-08-12T15:56:53.242Z","0.4.0":"2026-08-24T10:01:57.014Z","0.4.1":"2026-10-01T11:30:48.324Z"},"bugs":{"url":"https://github.com/drizzle-team/minipg/issues"},"license":"MIT","homepage":"https://github.com/drizzle-team/minipg#readme","keywords":["postgres","postgresql","pg","database","driver","cloudflare-workers","hyperdrive","deno","bun","edge"],"repository":{"url":"git+https://github.com/drizzle-team/minipg.git","type":"git"},"description":"A minimal, dependency-free PostgreSQL driver for Node, Bun, Deno, and Cloudflare Workers.","maintainers":[{"name":"dankochetov","email":"danil.kochetov+npm@gmail.com"},{"name":"sheriman","email":"andreysherman11@gmail.com"},{"name":"alexblokh","email":"aleksandrblokh@gmail.com"},{"name":"kyrylo_usichenko","email":"kyrylo.usichenko@gmail.com"}],"readme":"# @drizzle-team/minipg\n\n> [!WARNING]\n> Internal Drizzle Team package. Not supported for outside use. Breaking changes can land\n> without notice.\n\nA minimal, dependency-free PostgreSQL driver for Node, Bun, Deno, and Cloudflare Workers. It\ncovers the wire protocol directly and ships as ESM only, with 13 subpath entry points for\neach supported runtime and adapter.\n\n## Install\n\n```bash\npnpm add @drizzle-team/minipg\n```\n\n```bash\nnpm install @drizzle-team/minipg\n```\n\n```bash\nbun add @drizzle-team/minipg\n```\n\n## Usage\n\nThe example below queries a local cluster. From a checkout of this repo, provision one with:\n\n```bash\nbun run test:setup\n```\n\nThat starts Postgres on `127.0.0.1:54329` with a `testdb` database and a seeded table `t`. It uses\nlocal PostgreSQL binaries when `initdb`/`pg_ctl` are on PATH and a Docker container otherwise (force\neither with `MINIPG_PG_MODE=native|docker`; remove the container with `docker rm -f minipg-test-pg`).\nAny other Postgres works too — point the config below at it.\n\n```js\nimport { connect } from '@drizzle-team/minipg'\n\nconst db = await connect({\n  host: '127.0.0.1',\n  port: 54329,\n  user: 'postgres',\n  password: 'postgres',\n  database: 'testdb',\n})\n\nconst result = await db.query('select id, name, n8, amount from t order by id')\nconsole.log(result.rows)\n\nawait db.end()\n```\n\n`n8` (bigint) comes back as a native JS `BigInt`, and `amount` (numeric) comes back as a\nstring, since both types can exceed the range a JS number can represent without losing\nprecision.\n\nBuilt-in array columns (`int4[]`, `text[]`, `jsonb[]`, `timestamptz[]`, …) decode to JS\narrays, with each element following the scalar rules above — so `int8[]` yields `BigInt`s\nand `numeric[]` yields exact strings. Arrays whose element type has a per-database OID\n(`enum[]`, `domain[]`, composite arrays) can't be recognised from the wire OID alone and\nstill arrive as the raw `{…}` literal; declare a `shape` for those. To opt back out for a\ngiven type, override its array OID in `types` (e.g. `types: { 1007: (b) => b.toString() }`).\n","readmeFilename":"README.md"}