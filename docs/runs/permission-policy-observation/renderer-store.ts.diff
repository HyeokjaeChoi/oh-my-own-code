+export type PermissionPolicy = {
+  generation: number;
+  request?: PermissionPolicyIdentity | undefined;
+  observationIdentity?: PermissionPolicyIdentity;
+  observation?: WorkbenchPermissionPolicyObservation;
+  error?:
+    | "CANCELLED"
+    | "STALE"
