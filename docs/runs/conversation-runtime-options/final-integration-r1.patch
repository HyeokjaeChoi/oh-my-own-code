+test("Runtime options runner owned exit handles success, failed quit and already exited processes without Electron", async () => {
+  const source = await readFile(
+    new URL("../e2e-runtime-options.mjs", import.meta.url),
+    "utf8",
+  );
+  const code = source.match(
+    /async function stopOwnedApplication\(application, processHandle\) \{[\s\S]*?\n\}/u,
+  )?.[0];
+  assert.ok(code);
+  const build = (schedule = setTimeout, clear = clearTimeout) =>
+    new Function("bounded", "setTimeout", "clearTimeout", `return (${code});`)(
+      (e) => String(e),
+      schedule,
+      clear,
+    );
+  const child = new EventEmitter();
+  Object.assign(child, { pid: 123, exitCode: null, signalCode: null });
+  child.kill = () => assert.fail("Successful quit must not kill a process");
+  const application = {
+    evaluate: async (callback) =>
+      callback({
+        app: {
+          quit() {
+            queueMicrotask(() => child.emit("exit", 0, null));
+          },
+        },
+      }),
+  };
+  const exit = await build()(application, child);
+  assert.equal(exit.exited, true);
+  assert.equal(exit.code, 0);
+  assert.deepEqual(exit.signals, []);
+  assert.equal(child.listenerCount("exit"), 0);
+  child.exitCode = 0;
+  assert.equal(
+    (await build()({ evaluate: () => assert.fail("Already exited") }, child))
+      .exited,
+    true,
+  );
+  const orphan = new EventEmitter();
+  Object.assign(orphan, { pid: 456, exitCode: null, signalCode: null });
+  const deadlines = [],
+    signals = [];
+  orphan.kill = (signal) => {
+    signals.push(signal);
+    orphan.emit("exit", null, signal);
+  };
+  const forced = await build(
+    (callback, ms) => {
+      deadlines.push(ms);
+      queueMicrotask(callback);
+      return ms;
+    },
+    () => {},
+  )(
+    {
+      evaluate() {
+        throw Error("Synthetic quit failure");
+      },
+    },
+    orphan,
+  );
+  assert.equal(forced.exited, true);
+  assert.equal(forced.signal, "SIGTERM");
+  assert.deepEqual(signals, ["SIGTERM"]);
+  assert.ok(deadlines.every((ms) => ms <= 15000));
+  assert.equal(orphan.listenerCount("exit"), 0);
+  assert.equal((await build()(undefined, undefined)).exited, false);
+});
