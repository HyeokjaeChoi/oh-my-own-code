+        ids: Array.from({ length: 65 }, (_, n) => String(n)),
+      },
+    },
+    { ...base, variants: { status: "available", ids: ["x".repeat(257)] } },
+    { ...base, variants: { status: "available", ids: ["bad\u0000id"] } },
+    { ...base, variants: { status: "available", ids: ["\ud800"] } },
