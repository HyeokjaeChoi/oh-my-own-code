+    sessionId,
+    ...(own(info, "agent") ? { agent: info.agent } : {}),
+    ...(own(info, "model") ? { model: projectNativeModel(info.model) } : {}),
+  };
+  return validSessionSelection(value) ? value : undefined;
+}
