+test("actual saved composer helper accepts separated tasks and rejects overlap/containment defects", async () => {
+  const source = await readFile(
+    new URL("./e2e-workbench-states.mjs", import.meta.url),
+    "utf8",
+  );
+  const code = source.match(
+    /async function assertComposerGeometry\(page\) \{[\s\S]*?\n\}/u,
+  )?.[0];
+  assert.ok(
+    code,
+    "Use the production saved helper, not a mirrored geometry predicate",
+  );
+  const rect = (top, bottom, left = 10, right = 410) => ({
+    top,
+    bottom,
+    left,
+    right,
+    height: bottom - top,
+    width: right - left,
+  });
+  async function execute(patch = {}) {
+    const boxes = {
+      composer: rect(200, 340),
+      input: rect(216, 288, 26, 394),
+      toolbar: rect(296, 328, 26, 394),
+      requests: rect(10, 170),
+      ...patch,
+    };
+    const nodes = Object.fromEntries(
+      Object.entries(boxes).map(([key, box]) => [
+        key,
+        { getBoundingClientRect: () => box },
+      ]),
+    );
+    const form = nodes.composer;
+    form.querySelector = (selector) =>
+      selector.includes("button") ? { parentElement: nodes.toolbar } : null;
+    form.contains = (node) =>
+      node === nodes.input ||
+      node === nodes.toolbar ||
+      (!!patch.nested && node === nodes.requests);
+    nodes.input.closest = () => form;
+    nodes.input.ownerDocument = { querySelector: () => nodes.requests };
+    nodes.requests.closest = () =>
+      patch.closed ? { open: false } : patch.nested ? form : null;
+    nodes.requests.getClientRects = () => [boxes.requests];
+    const observations = [];
+    await new Function("assert", "observations", `return (${code});`)(
+      assert,
+      observations,
+    )({ getByRole: () => ({ evaluate: async (fn) => fn(nodes.input) }) });
+    return observations;
+  }
+  assert.equal((await execute()).length, 1);
+  assert.equal(
+    (await execute({ closed: true, requests: rect(260, 380) })).length,
+    1,
+    "A closed details task may retain layout boxes without being painted",
+  );
+  for (const patch of [
+    { nested: true },
+    { toolbar: rect(280, 312) },
+    { input: rect(190, 262) },
+    { toolbar: rect(320, 352) },
+    { input: rect(216, 288, 0, 394) },
+    { input: rect(216, 230) },
+    { requests: rect(260, 380) },
+  ])
+    await assert.rejects(execute(patch), JSON.stringify(patch));
+});
