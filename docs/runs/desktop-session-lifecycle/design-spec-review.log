      if (
        info?.id !== s.sdkId ||
        (await canonicalDirectory(info.location?.directory)) !==
          workspace(s.workspaceId).path ||
        !policyMatches(info.permissions)
      )
        fail("POLICY_UNVERIFIED");
      s.policyError = false;
      return info;
    } catch {
      s.policyError = true;
      fail("POLICY_UNVERIFIED");
    }
  }
