    else if (specifier.startsWith("node:") || builtins.has(specifier))
      issue = "Node builtin in renderer graph";
    else if (approvedExternal.has(specifier)) {
      if (
        !ts.resolveModuleName(specifier, file, config.options, ts.sys)
          .resolvedModule
      )
        issue = "unresolved approved dependency";
    } else {
      target = publicEntries.get(specifier);
      if (!target && specifier.startsWith(".")) {
        const literal = resolve(dirname(file), specifier);
        if (
          existsSync(literal) &&
          statSync(literal).isFile() &&
          !/\.d\.[cm]?ts$/.test(literal)
        )
          target = literal;
      }
      if (!target)
        target = ts.resolveModuleName(specifier, file, config.options, ts.sys)
          .resolvedModule?.resolvedFileName;
      if (!target) issue = "unresolved or unapproved dependency";
      else {
        target = realpathSync(target);
        issue = localViolation(file, target, specifier, item.typeOnly);
        if (!issue) queue.push(target);
      }
    }
    if (issue) {
      const line =
        source.getLineAndCharacterOfPosition(item.node.getStart(source)).line +
        1;
      errors.push(`${relative(root, file)}:${line}: ${issue} (${specifier})`);
    }
  }
}

