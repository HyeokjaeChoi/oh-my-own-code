function displayTarget(result: unknown) {
  const candidate = parseSafeLinkPreview(result)?.href;
  if (!candidate) return "대상 확인 불가";
  try {
    const url = new URL(candidate);
    if (
      !["https:", "http:"].includes(url.protocol) ||
      url.username ||
      url.password
    )
      return "대상 확인 불가";
    return `${url.host}${url.pathname === "/" ? "" : url.pathname}`;
  } catch {
    return "대상 확인 불가";
  }
}

function ToolCallSummary({
  toolName,
  status,
  target,
}: {
  toolName: string;
  status: { label: string; tone: StatusBadgeTone };
  target: string;
}) {
  return (
    <div className="tool-call-summary" aria-label={`${toolName} 도구 호출`}>
      <div className="tool-call-heading">
        <span className="tool-call-name">{toolName}</span>
        <StatusBadge label={status.label} tone={status.tone} />
      </div>
      <p className="tool-call-target">
        <span>대상</span>
        <span>{target}</span>
      </p>
    </div>
  );
}

export function PreviewLinkToolRenderer({
  isError,
  result,
  status,
  toolName = "previewLink",
}: PreviewLinkToolProps) {
  const parsed = parseSafeLinkPreview(result);
  const callStatus =
    isError || status?.type === "incomplete"
      ? { label: "실패", tone: "error" as const }
      : status?.type === "running"
        ? { label: "실행 중", tone: "info" as const }
        : status?.type === "complete"
          ? { label: "확인 완료", tone: "success" as const }
          : { label: "상태 확인 중", tone: "neutral" as const };
  const target = displayTarget(result);

  if (parsed)
    return (
      <div className="tool-result">
        <ToolCallSummary
          toolName={toolName}
          status={callStatus}
          target={target}
        />
        <div className="tool-result-card">
          <p className="tool-result-label">검증된 미리보기</p>
          <LinkPreview
            {...parsed}
            locale="ko-KR"
            className="omoc-link-preview"
            interactive={false}
          />
        </div>
      </div>
    );

  return (
    <div className="tool-result">
      <ToolCallSummary
        toolName={toolName}
        status={callStatus}
        target={target}
      />
      <div
        className="tool-fallback"
        role="note"
        data-tool-fallback="previewLink"
      >
        링크 미리보기 결과를 표시할 수 없습니다. 실행 동작은 없습니다.
      </div>
    </div>
  );
}

const toolKit: Toolkit = {
  previewLink: {
    type: "backend",
    render: PreviewLinkToolRenderer,
  },
};

function NoActionToolFallback({ toolName }: { toolName: string }) {
  return (
    <div className="tool-fallback" role="note" data-tool-fallback={toolName}>
      {toolName === "previewLink"
        ? "도구 결과를 일반 표시로 남깁니다. 실행 동작은 없습니다."
        : "등록되지 않은 도구 결과입니다. 실행 동작 없이 일반 결과로 남깁니다."}
    </div>
  );
}

function MessageView({
  role,
  provenance,
}: {
  role: "user" | "assistant";
  provenance: "message" | "event";
}) {
  return (
    <MessagePrimitive.Root
      className={`transcript-message transcript-message--${role}`}
      data-provenance={provenance}
    >
      <div className="transcript-message-meta">
        <span className="transcript-speaker">
          {role === "user" ? "사용자" : "도우미"}
        </span>
        {provenance === "event" && (
          <span className="transcript-origin">이벤트</span>
        )}
      </div>
      <MessagePrimitive.Parts
        components={{
          Text: ({ text }) => <p className="transcript-text">{text}</p>,
          tools: {
            by_name: { previewLink: PreviewLinkToolRenderer },
            Fallback: NoActionToolFallback,
          },
        }}
      />
    </MessagePrimitive.Root>
  );
}

export function AssistantTranscript({
  projectedSnapshot,
}: {
  projectedSnapshot: SyntheticSnapshot;
}) {
  const messages: ThreadMessageLike[] =
    toAssistantThreadMessages(projectedSnapshot);
  const runtime = useExternalStoreRuntime({
    messages,
    isRunning: projectedSnapshot.run.status === "running",
    convertMessage: (message) => message,
    onNew: async () => undefined,
  });
  const aui = useAui({ tools: Tools({ toolkit: toolKit }) });

  return (
    <AssistantRuntimeProvider runtime={runtime} aui={aui}>
      <ThreadPrimitive.Messages>
        {({ message }) => (
          <MessageView
            key={message.id}
            role={message.role === "user" ? "user" : "assistant"}
            provenance={
              message.metadata.custom.provenance === "event"
                ? "event"
                : "message"
            }
          />
        )}
      </ThreadPrimitive.Messages>
    </AssistantRuntimeProvider>
  );
}
import { z } from "zod";

export const MAX_TOOL_RESULT_BYTES = 8 * 1024;
const safeWebUrl = z
  .string()
  .url()
  .refine((value) => {
    try {
      return ["https:", "http:"].includes(new URL(value).protocol);
    } catch {
      return false;
    }
  }, "Only HTTP(S) URLs are supported");

const SafeText = z
  .string()
  .max(2_000)
  .refine(
    (value) => !/<\/?[a-z][\s\S]*?>/i.test(value),
    "Markup is not display text",
  );
export const LinkPreviewSchema = z
  .object({
    id: z.string().min(1).max(120),
    href: safeWebUrl,
    title: SafeText.optional(),
    description: SafeText.optional(),
    domain: SafeText.optional(),
  })
  .strict();
export type LinkPreviewPayload = z.infer<typeof LinkPreviewSchema>;

export function parseSafeLinkPreview(
  value: unknown,
): LinkPreviewPayload | null {
  try {
    const serialized = JSON.stringify(value);
    if (
      serialized === undefined ||
      new TextEncoder().encode(serialized).byteLength > MAX_TOOL_RESULT_BYTES
    )
      return null;
    return LinkPreviewSchema.parse(JSON.parse(serialized));
  } catch {
    return null;
  }
}

const MessagePartSchema = z.discriminatedUnion("type", [
  z
    .object({
      id: z.string(),
      type: z.literal("text"),
      text: z.string().max(4_000),
    })
    .strict(),
  z
    .object({
      id: z.string(),
      type: z.literal("tool"),
      toolCallId: z.string(),
      toolName: z.string(),
      args: z.record(z.string(), z.unknown()),
      result: z.unknown(),
      status: z.enum(["complete", "error"]),
    })
    .strict(),
]);
export const SnapshotMessageSchema = z
  .object({
    id: z.string(),
    sessionId: z.string().min(1),
    role: z.enum(["user", "assistant"]),
    runId: z.string().nullable(),
    content: z.array(MessagePartSchema),
  })
  .strict();
export type SnapshotMessage = z.infer<typeof SnapshotMessageSchema>;

export const SyntheticSnapshotSchema = z
  .object({
    source: z.literal("synthetic-fixture"),
    revision: z.number().int().nonnegative(),
    eventCursor: z.number().int().nonnegative(),
    workspace: z
      .object({ id: z.string(), name: z.string(), label: z.string() })
      .strict(),
    session: z.object({ id: z.string(), title: z.string() }).strict(),
    run: z
      .object({
        id: z.string(),
        status: z.enum(["running", "complete", "unknown"]),
      })
      .strict(),
    messages: z.array(SnapshotMessageSchema),
    events: z.array(
      z.discriminatedUnion("type", [
        z
          .object({
            id: z.string(),
            sequence: z.number().int().positive(),
            type: z.literal("run.status"),
            sessionId: z.string().min(1),
            runId: z.string(),
            status: z.enum(["running", "complete", "unknown"]),
          })
          .strict(),
        z
          .object({
            id: z.string(),
            sequence: z.number().int().positive(),
            type: z.literal("message.appended"),
            sessionId: z.string().min(1),
            message: SnapshotMessageSchema,
          })
          .strict(),
      ]),
    ),
  })
  .strict();
export type SyntheticSnapshot = z.infer<typeof SyntheticSnapshotSchema>;

