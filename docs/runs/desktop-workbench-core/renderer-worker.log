import test from 'node:test';
import assert from 'node:assert/strict';
import { selectionKey, acceptSnapshot, mapMessages, preserveDraft, createRequestGate } from './renderer/shared/projection.mjs';
const snapshot = (revision = 1, sessionId = 'a') => ({ revision, selectedWorkspaceId: 'w', selectedSessionId: sessionId, messages: [] });
test('generation and pair checks reject a late response even after switching back', () => {
  const expected = { generation: 3, workspaceId: 'w', sessionId: 'a' };
  assert.equal(acceptSnapshot(null, snapshot(), expected, 1), null);
  assert.equal(acceptSnapshot(null, snapshot(1, 'b'), expected, 3), null);
  assert.equal(acceptSnapshot(null, snapshot(), expected, 3)?.revision, 1);
});
test('duplicate and older revisions retain the existing projection', () => {
  const current = snapshot(4), expected = { generation: 1, workspaceId: 'w', sessionId: 'a' };
  assert.equal(acceptSnapshot(current, snapshot(3), expected, 1), current);
  assert.equal(acceptSnapshot(current, snapshot(4), expected, 1), current);
});
test('mapping bounds content and removes duplicate IDs without executable content parts', () => {
  const raw = { id: 'x', role: 'assistant', text: '<script>alert(1)</script>', tools: [{id:'t',name:'html',status:'pending',input:'{}',output:'<img onerror=\"bad()\">'}] };
  const mapped = mapMessages([raw, raw]);
  assert.equal(mapped.length, 1);
  assert.deepEqual(mapped[0].content[0], { type:'text', text:raw.text });
  assert.equal(mapped[0].content[1].result, undefined);
  assert.equal(mapped[0].content[1].args.output, raw.tools[0].output);
  assert.ok(mapMessages(Array.from({length:600}, (_,i) => ({...raw,id:String(i),text:'x'.repeat(100000)}))).length <= 300);
  assert.ok(mapMessages([{...raw,text:'x'.repeat(100000)}])[0].content[0].text.length < 66000);
});
test('tool completion comes from tool status, never an accepted request receipt', () => {
  const messages = mapMessages([{id:'m',role:'assistant',text:'',tools:[{id:'t',name:'run',status:'running',input:'',output:'{\"status\":\"accepted\"}'}]}]);
  assert.equal(messages[0].content[1].result, undefined);
  assert.equal(messages[0].content[1].args.state, 'running');
});
test('drafts are immutable and isolated by workspace/session', () => {
  const a = selectionKey('w','a'), b = selectionKey('w','b');
  const first = preserveDraft({}, a, '첫 초안');
  const next = preserveDraft(first, b, '다른 초안');
  assert.equal(next[a], '첫 초안'); assert.equal(next[b], '다른 초안'); assert.equal(first[b], undefined);
  assert.notEqual(selectionKey('a:b','c'), selectionKey('a','b:c'));
});
test('request gate prevents overlap and ignores releases from obsolete tokens', () => {
  const gate = createRequestGate();
  const first = gate.start(); assert.ok(first); assert.equal(gate.start(), null);
  gate.finish({}); assert.equal(gate.start(), null);
  gate.finish(first); assert.ok(gate.start());
});
