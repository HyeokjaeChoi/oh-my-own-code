     4	export function acceptSnapshot(current, next, selection, generation) {
     5	  if (
     6	    generation !== selection.generation ||
     7	    (selection.workspaceId &&
     8	      next.selectedWorkspaceId !== selection.workspaceId) ||
     9	    (selection.sessionId && next.selectedSessionId !== selection.sessionId)
    10	  )
    11	    return current;
    12	  if (current && next.revision <= current.revision) return current;
    13	  return next;
    14	}
    15	const bounded = (value, limit = 65536) =>
