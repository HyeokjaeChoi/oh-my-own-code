     1	import { useEffect, useRef, useState } from "react";
     2	import { request, type WorkbenchCatalog } from "../../shared/index.js";
     3	
     4	type Listing = {
     5	  path: string;
     6	  entries: { name: string; path: string; type: "file" | "directory" }[];
     7	};
     8	type Preview = { path: string; content: string; truncated: boolean };
     9	export function FileExplorer({ workspaceId }: { workspaceId: string }) {
    10	  const [listing, setListing] = useState<Listing | null>(null);
    11	  const [preview, setPreview] = useState<Preview | null>(null);
    12	  const [error, setError] = useState("");
    13	  const [busy, setBusy] = useState(false);
    14	  const active = useRef(true);
    15	  const gate = useRef(false);
    16	  async function load(path: string, file = false) {
    17	    if (gate.current) return;
    18	    gate.current = true;
    19	    setBusy(true);
    20	    setError("");
    21	    setPreview(null);
    22	    try {
    23	      if (file) {
    24	        const result = await request<Preview>({
    25	          type: "file.read",
    26	          workspaceId,
    27	          path,
    28	        });
    29	        if (!active.current) return;
    30	        if (result.ok) setPreview(result.value);
    31	        else setError(`${result.code}: ${result.message}`);
    32	      } else {
    33	        const result = await request<Listing>({
    34	          type: "file.list",
    35	          workspaceId,
    36	          ...(path ? { path } : {}),
    37	        });
    38	        if (!active.current) return;
    39	        if (result.ok) setListing(result.value);
    40	        else setError(`${result.code}: ${result.message}`);
    41	      }
    42	    } catch {
    43	      if (active.current)
    44	        setError("파일을 읽을 수 없습니다. 연결을 확인하고 다시 시도하세요.");
    45	    } finally {
    46	      gate.current = false;
    47	      if (active.current) setBusy(false);
    48	    }
    49	  }
    50	  useEffect(() => {
    51	    active.current = true;
    52	    void load("");
    53	    return () => {
    54	      active.current = false;
    55	    };
    56	  }, []);
    57	  const parent = listing?.path.split("/").slice(0, -1).join("/") ?? "";
    58	  return (
    59	    <section className="file-explorer" aria-label="읽기 전용 파일 탐색">
    60	      <p className="muted">읽기 전용 · 텍스트 미리보기</p>
    61	      <div className="actions">
    62	        <button disabled={busy} onClick={() => void load("")}>
    63	          루트
    64	        </button>
    65	        <button
    66	          disabled={busy || !listing?.path}
    67	          onClick={() => void load(parent)}
    68	        >
    69	          상위 폴더
    70	        </button>
    71	        <button disabled={busy} onClick={() => void load(listing?.path ?? "")}>
    72	          새로고침
    73	        </button>
    74	      </div>
    75	      <p className="file-path">{listing?.path || "/"}</p>
    76	      {busy && <p role="status">불러오는 중…</p>}
    77	      {error && (
    78	        <p role="alert" className="error">
    79	          {error}
    80	        </p>
    81	      )}
    82	      {listing && !listing.entries.length && (
    83	        <p className="muted">빈 폴더입니다.</p>
    84	      )}
    85	      <ul className="file-list">
    86	        {listing?.entries.map((entry) => (
    87	          <li key={entry.path}>
    88	            <button
    89	              disabled={busy}
    90	              onClick={() => void load(entry.path, entry.type === "file")}
    91	            >
    92	              <span aria-hidden="true">
    93	                {entry.type === "directory" ? "▸" : "·"}
    94	              </span>
    95	              <span>{entry.name}</span>
    96	              <span className="sr-only">
    97	                {entry.type === "directory" ? "폴더 열기" : "파일 미리보기"}
    98	              </span>
    99	            </button>
   100	          </li>
   101	        ))}
   102	      </ul>
   103	      {preview && (
   104	        <section aria-label="파일 내용">
   105	          <h3 className="file-path">{preview.path}</h3>
   106	          {preview.truncated && (
   107	            <p role="status">파일 크기 제한으로 앞부분만 표시합니다.</p>
   108	          )}
   109	          <pre className="file-content">{preview.content || "(빈 파일)"}</pre>
   110	        </section>
   111	      )}
   112	    </section>
   113	  );
   114	}
   115	const collectionNames = {
   116	  commands: "명령",
   117	  skills: "스킬",
   118	  mcp: "MCP",
   119	  agents: "에이전트",
   120	  models: "모델",
   121	} as const;
   122	export function CatalogPanel({
   123	  catalog,
   124	  error,
   125	  refresh,
   126	}: {
   127	  catalog: WorkbenchCatalog | null;
   128	  error: string;
   129	  refresh(): void;
   130	}) {
   131	  return (
   132	    <section className="catalog" aria-label="런타임 확장 목록">
   133	      <div className="panel-heading">
   134	        <p className="muted">현재 작업 공간의 런타임 목록</p>
   135	        <button onClick={refresh}>새로고침</button>
   136	      </div>
   137	      {error && (
   138	        <p role="alert" className="error">
   139	          {error}
   140	        </p>
   141	      )}
   142	      {!catalog && !error && <p role="status">목록 확인 중…</p>}
   143	      {catalog &&
   144	        (Object.keys(collectionNames) as (keyof typeof collectionNames)[]).map(
   145	          (key) => (
   146	            <section className="catalog-group" key={key}>
   147	              <h3>{collectionNames[key]}</h3>
   148	              {catalog[key].status === "unavailable" ? (
   149	                <p className="muted">
   150	                  사용 불가 · 신뢰 확인 또는 런타임 지원이 필요합니다.
   151	                </p>
   152	              ) : !catalog[key].entries.length ? (
   153	                <p className="muted">사용 가능 · 등록된 항목이 없습니다.</p>
   154	              ) : (
   155	                <ul>
   156	                  {catalog[key].entries.map((entry) => (
   157	                    <li key={entry.id}>
   158	                      <strong>{entry.name}</strong>
   159	                      {entry.description && <p>{entry.description}</p>}
   160	                      {entry.status && <small>상태: {entry.status}</small>}
   161	                    </li>
   162	                  ))}
   163	                </ul>
   164	              )}
   165	            </section>
   166	          ),
   167	        )}
   168	      <p className="muted">
   169	        설치·연결 변경은 지원하지 않습니다. 명령 실행과 스킬 언급은 작성기의
   170	        명령 목록에서 선택하세요.
   171	      </p>
   172	    </section>
   173	  );
   174	}
