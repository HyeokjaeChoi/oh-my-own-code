    59	export function createRequestGate() {
    60	  let active = null;
    61	  return {
    62	    start() {
    63	      if (active) return null;
    64	      active = {};
    65	      return active;
    66	    },
    67	    finish(token) {
    68	      if (token === active) active = null;
    69	    },
    70	  };
