    19	export function mapMessages(messages) {
    20	  const seen = new Set();
    21	  return messages
    22	    .slice(-300)
    23	    .filter((message) => {
    24	      if (seen.has(message.id)) return false;
    25	      seen.add(message.id);
    26	      return true;
    27	    })
    28	    .map((message) => ({
    29	      id: message.id,
    30	      role: message.role,
    31	      content: [
    32	        { type: "text", text: bounded(message.text) },
    33	        ...(message.role === "assistant"
    34	          ? message.tools.slice(0, 40).map((tool) => ({
    35	              type: "tool-call",
    36	              toolCallId: tool.id,
    37	              toolName: tool.name,
    38	              args: {
    39	                input: bounded(tool.input, 8192),
    40	                output: bounded(tool.output),
    41	                state: tool.status,
    42	              },
    43	              argsText: bounded(tool.input, 8192),
    44	              ...(tool.status === "completed" || tool.status === "error"
    45	                ? {
    46	                    result: bounded(tool.output),
    47	                    isError: tool.status === "error",
    48	                  }
    49	                : {}),
    50	            }))
    51	          : []),
    52	      ],
    53	    }));
    54	}
