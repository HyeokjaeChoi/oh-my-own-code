     1	import { createRequire } from "node:module";
     2	import { readFile } from "node:fs/promises";
     3	import { dirname, join, resolve } from "node:path";
     4	import { fileURLToPath, pathToFileURL } from "node:url";
     5	
     6	const root = resolve(dirname(fileURLToPath(import.meta.url)), "../../..");
     7	const [platform, arch] = process.argv.slice(2);
     8	if (!platform || !arch)
     9	  throw new Error("Usage: package.mjs <darwin|win32> <arm64|x64>");
    10	if (platform !== process.platform || arch !== process.arch) {
    11	  throw new Error(
    12	    "Build each desktop target on its native OS and architecture",
    13	  );
    14	}
    15	
    16	const require = createRequire(import.meta.url);
    17	const appMetadata = JSON.parse(
    18	  await readFile(join(root, "apps", "desktop-app", "package.json"), "utf8"),
    19	);
    20	const electronVersion = require("electron/package.json").version;
    21	if (electronVersion !== appMetadata.devDependencies.electron) {
    22	  throw new Error(
    23	    "Installed Electron does not match the pinned desktop version",
    24	  );
    25	}
    26	const packagerPath = require.resolve("@electron/packager");
    27	const { packager } = await import(pathToFileURL(packagerPath).href);
    28	const output = join(root, "apps", "desktop-app", "dist", "packages");
    29	const appDir = join(root, "apps", "desktop-app", "dist", "app");
    30	const resources = join(root, "apps", "desktop-app", "dist", "resources");
    31	const appPath = await packager({
    32	  dir: appDir,
    33	  name: "OhMyOwnCode",
    34	  platform,
    35	  arch,
    36	  electronVersion,
    37	  // A caller may supply an already downloaded, trusted Electron distribution.
    38	  // Packager verifies the exact version/platform/architecture archive filename.
    39	  ...(process.env.OMOC_ELECTRON_ZIP_DIR && {
    40	    electronZipDir: resolve(process.env.OMOC_ELECTRON_ZIP_DIR),
    41	  }),
    42	  out: output,
    43	  overwrite: true,
    44	  prune: false,
    45	  asar: true,
    46	  extraResource: [join(resources, "opencode")],
    47	});
    48	console.log(`Packaged local personal-use app: ${appPath[0]}`);
