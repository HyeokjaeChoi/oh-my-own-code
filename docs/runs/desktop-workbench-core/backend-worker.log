    );
    throwIfAborted();
    child = spawnProcess(
      binaryPath,
      ["serve", "--hostname", "127.0.0.1", "--port", String(port)],
      {
        cwd: workspace,
        env: childEnvironment(root, platform, systemRoot),
        stdio: ["ignore", "pipe", "pipe"],
