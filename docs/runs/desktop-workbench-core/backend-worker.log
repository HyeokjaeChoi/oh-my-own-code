    // Finish every setup operation before cleanup can begin on a failed setup.
    const setupDirectories = [
      "config/opencode",
      "data",
      "cache",
      "state",
      "tmp",
      "workspace",
    ];
    if (platform === "win32") {
      setupDirectories.push("AppData/Roaming", "AppData/Local");
