+export const CONTEXT_LIMITS = Object.freeze({
+  textBytes: 65536,
+  fileBytes: 8388608,
+  sendBytes: 16777216,
+  items: 8,
+  cacheBytes: 67108864,
+  cacheEntries: 64,
